@charset "utf-8";

:root { --blinkit-yellow: #FFC200; --blinkit-dark: #1B1B1B; --blinkit-light: #F7F9FA; --blinkit-green: #037A38; --blinkit-red: #D32F2F; }

* { box-sizing: border-box; font-family: "Segoe UI", Tahoma, Geneva, Verdana, sans-serif; }

body { background-color: var(--blinkit-light); margin: 0px; padding: 15px; color: var(--blinkit-dark); }

header { background-color: var(--blinkit-dark); color: white; padding: 15px; border-radius: 8px; text-align: center; margin-bottom: 15px; border-bottom: 4px solid var(--blinkit-yellow); }

h1 { color: var(--blinkit-yellow); margin: 0px; font-size: 18px; }

h3 { color: rgb(204, 204, 204); margin: 4px 0px 0px; font-size: 11px; font-weight: normal; }

.nav-tabs { display: flex; gap: 8px; margin-bottom: 15px; justify-content: center; flex-wrap: wrap; }

.tab-btn { background: rgb(221, 221, 221); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; padding: 7px 12px; font-weight: bold; border-radius: 5px; cursor: pointer; font-size: 12px; }

.tab-btn.active { background: var(--blinkit-yellow); color: var(--blinkit-dark); }

.view-section { display: none; }

.view-section.active { display: block; }

.dashboard-container { max-width: 700px; margin: 0px auto; display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }

@media (max-width: 600px) {
  .dashboard-container { grid-template-columns: 1fr; }
}

.dept-card-home { background: white; border-top: 2px solid rgb(224, 224, 224); border-right: 2px solid rgb(224, 224, 224); border-bottom: 2px solid rgb(224, 224, 224); border-image: none; border-left: 6px solid var(--blinkit-yellow); padding: 18px; border-radius: 8px; text-align: center; cursor: pointer; font-size: 14px; font-weight: bold; box-shadow: rgba(0, 0, 0, 0.05) 0px 2px 5px; }

.dept-card-home:hover { background: var(--blinkit-yellow); }

.top-bar { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12px; background: white; padding: 10px; border-radius: 8px; border-left: 5px solid var(--blinkit-yellow); flex-wrap: wrap; gap: 8px; }

.btn-action { background: var(--blinkit-dark); color: white; border-width: medium; border-style: none; border-color: currentcolor; border-image: none; padding: 6px 10px; font-weight: bold; border-radius: 4px; cursor: pointer; font-size: 11px; }

.summary-bar { display: flex; gap: 10px; margin-bottom: 12px; }

.sum-box { flex: 1 1 0%; background: white; padding: 10px; border-radius: 6px; text-align: center; font-weight: bold; font-size: 13px; border-top: 4px solid rgb(204, 204, 204); box-shadow: rgba(0, 0, 0, 0.05) 0px 2px 4px; }

.sum-p { border-top-color: var(--blinkit-green); color: var(--blinkit-green); }

.sum-u { border-top-color: var(--blinkit-red); color: var(--blinkit-red); }

.card { background: white; padding: 12px; border-radius: 8px; box-shadow: rgba(0, 0, 0, 0.06) 0px 2px 8px; margin-bottom: 12px; border: 1px solid rgb(224, 224, 224); }

.card h4 { margin-top: 0px; color: var(--blinkit-dark); border-bottom: 2px solid var(--blinkit-yellow); padding-bottom: 5px; font-size: 13px; }

label { font-weight: 600; display: block; margin-top: 6px; font-size: 11px; color: rgb(85, 85, 85); }

input, select { width: 100%; padding: 6px; margin-top: 2px; border: 1px solid rgb(204, 204, 204); border-radius: 4px; font-size: 11px; }

.btn-main { background: var(--blinkit-yellow); color: var(--blinkit-dark); border-width: medium; border-style: none; border-color: currentcolor; border-image: none; padding: 9px; font-weight: bold; border-radius: 4px; cursor: pointer; width: 100%; margin-top: 10px; font-size: 12px; }

.table-container { overflow-x: auto; }

table { width: 100%; border-collapse: collapse; margin-top: 5px; font-size: 11px; }

th, td { border: 1px solid rgb(221, 221, 221); padding: 5px; text-align: center; }

th { background-color: var(--blinkit-dark); color: white; }

.badge-p { background-color: rgb(232, 245, 233); color: var(--blinkit-green); font-weight: bold; padding: 2px 6px; border-radius: 4px; display: inline-block; font-size: 12px; }

.badge-u { background-color: rgb(255, 235, 238); color: var(--blinkit-red); font-weight: bold; padding: 2px 6px; border-radius: 4px; display: inline-block; font-size: 12px; }

.call-btn { background: rgb(2, 136, 209); color: white; text-decoration: none; padding: 2px 5px; border-radius: 4px; font-size: 10px; font-weight: bold; display: inline-block; }

.timer-text { color: rgb(211, 47, 47); font-weight: bold; font-family: monospace; font-size: 12px; }
