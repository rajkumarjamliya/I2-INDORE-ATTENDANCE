<!DOCTYPE html><html lang="hi"><head><meta http-equiv="Content-Type" content="text/html; charset=UTF-8"><link rel="stylesheet" type="text/css" href="cid:css-390c89b0-5ce2-4920-8469-01bfba1897db@mhtml.blink" />
  
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Blinkit FC I2 Indore - Department Wise Attendance</title>
  
</head>
<body>

  <header>
    <h1>BLINKIT - FULFILLMENT CENTER (I2 INDORE)</h1>
    <h3>Department Wise Attendance &amp; Live Timer System</h3>
  </header>

  <!-- Navigation Tabs -->
  <div class="nav-tabs">
    <button class="tab-btn active">📅 Department Wise Attendance</button>
    <button class="tab-btn">👥 Add Employees</button>
    <button class="tab-btn">📊 Report &amp; Excel Download</button>
  </div>

  <!-- TAB 1: DAILY ATTENDANCE -->
  <div id="dailyView" class="view-section active">
    <div id="homeView">
      <h3 style="text-align: center; margin-bottom: 12px; color: #444; font-size: 13px;">SELECT DEPARTMENT</h3>
      <div class="dashboard-container">
        <div class="dept-card-home">📦 INBOUND</div>
        <div class="dept-card-home">📤 OUTBOUND</div>
        <div class="dept-card-home">🚚 DISPATCH</div>
        <div class="dept-card-home">🔄 RETURN</div>
        <div class="dept-card-home">📥 PUTAWAY</div>
        <div class="dept-card-home">🛡️ GUARD STAFF</div>
      </div>
    </div>

    <div id="deptView" style="display: none;">
      <div class="top-bar">
        <button class="btn-action">⬅ Back to Departments</button>
        <h2 id="deptTitle" style="margin:0; font-size: 13px;">INBOUND</h2>
        <div>
          <label style="display:inline; font-size:11px;">Date: </label>
          <input type="date" id="attendanceDate" style="width: auto; padding: 3px; display:inline;">
        </div>
      </div>

      <!-- Counting Summary Bar -->
      <div class="summary-bar">
        <div class="sum-box sum-p">🟢 Present (P): <span id="totalPCount">0</span></div>
        <div class="sum-box sum-u">🔴 Absent (U): <span id="totalUCount">0</span></div>
      </div>

      <div class="card">
        <h4 style="color: var(--blinkit-green);" id="deptTableHeading">📋 Attendance List</h4>
        <div class="table-container">
          <table>
            <thead>
              <tr>
                <th>ID</th>
                <th>Name &amp; Contact</th>
                <th>Status (P / U)</th>
                <th>Time In</th>
                <th>Time Out</th>
                <th>Live Working Timer</th>
                <th>Save</th>
              </tr>
            </thead>
            <tbody id="attendanceTableBody"></tbody>
          </table>
        </div>
      </div>
    </div>
  </div>

  <!-- TAB 2: ADD EMPLOYEES -->
  <div id="employeesView" class="view-section">
    <div class="card" style="max-width: 500px; margin: 0 auto; background: #fffcf0;">
      <h4>➕ Add Employee to Department</h4>
      <label>Select Department:</label>
      <select id="empDept">
        <option value="Inbound">Inbound</option>
        <option value="Outbound">Outbound</option>
        <option value="Dispatch">Dispatch</option>
        <option value="Return">Return</option>
        <option value="Putaway">Putaway</option>
        <option value="Guard Staff">Guard Staff</option>
      </select>

      <label>Employee ID:</label>
      <input type="text" id="newEmpId" placeholder="e.g. BLK-101">

      <label>Full Name:</label>
      <input type="text" id="newEmpName" placeholder="Employee Name">

      <label>Mobile Number (For Call):</label>
      <input type="tel" id="newEmpMobile" placeholder="9898XXXXXX">

      <button class="btn-main">Save Employee</button>
    </div>

    <div class="card" style="margin-top: 15px;">
      <h4>📁 Saved Employees Directory (All Departments)</h4>
      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th>Dept</th>
              <th>ID</th>
              <th>Name</th>
              <th>Mobile</th>
              <th>Action</th>
            </tr>
          </thead>
          <tbody id="masterEmpTableBody"></tbody>
        </table>
      </div>
    </div>
  </div>

  <!-- TAB 3: REPORT & EXCEL -->
  <div id="reportView" class="view-section">
    <div class="card">
      <h4>📊 Date-to-Date Report &amp; Excel Download</h4>
      <div style="display: flex; gap: 8px; flex-wrap: wrap; margin-bottom: 10px; align-items: center;">
        <div>
          <label>From Date:</label>
          <input type="date" id="startDate">
        </div>
        <div>
          <label>To Date:</label>
          <input type="date" id="endDate">
        </div>
        <div>
          <label>Department:</label>
          <select id="reportDept">
            <option value="ALL">All Departments</option>
            <option value="Inbound">Inbound</option>
            <option value="Outbound">Outbound</option>
            <option value="Dispatch">Dispatch</option>
            <option value="Return">Return</option>
            <option value="Putaway">Putaway</option>
            <option value="Guard Staff">Guard Staff</option>
          </select>
        </div>
        <div style="align-self: flex-end;">
          <button class="btn-action" style="background: var(--blinkit-green); padding: 8px 12px;">🔍 Generate</button>
          <button class="btn-action" style="background: #0288D1; padding: 8px 12px;">📥 Download Excel</button>
        </div>
      </div>

      <div class="table-container">
        <table>
          <thead>
            <tr>
              <th>Date</th>
              <th>Dept</th>
              <th>ID</th>
              <th>Name</th>
              <th>Contact</th>
              <th>Status</th>
              <th>Time In</th>
              <th>Time Out</th>
              <th>Working Status</th>
            </tr>
          </thead>
          <tbody id="reportTableBody">
            <tr><td colspan="9" style="color:#777;">Select dates and click Generate.</td></tr>
          </tbody>
        </table>
      </div>
    </div>
  </div>

  


</body></html>
